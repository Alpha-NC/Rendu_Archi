# RIF-App — variables d'environnement (Phase 0A/0B).
# Ne jamais commiter de vraies valeurs. Ce fichier ne documente que les noms.

# LLM multimodal — Claude Sonnet 5 (D-06, docs/decision-llm-multimodal.md).
ANTHROPIC_API_KEY=

# fal.ai — appel direct depuis le backend applicatif (D-05), endpoint
# fal-ai/nano-banana-pro/edit.
FAL_KEY=

# Vercel Blob — cible de stockage PRD V2.1 (D-19), lib/storage/vercel-blob.ts.
# Autogénéré par Vercel à la création d'un Blob store — ne jamais préfixer
# NEXT_PUBLIC_, jamais exposé au client.
BLOB_READ_WRITE_TOKEN=

# Neon PostgreSQL — base réelle depuis la bascule (D-19, 17.09.2026),
# lib/rif/depot-neon.ts, neon/schema.sql, obtenirDepot(). Chaîne de
# connexion complète (postgres://...) — jamais préfixée NEXT_PUBLIC_,
# jamais exposée au client (PRD §18). Autogénéré par `neon deploy`.
DATABASE_URL=

# Neon Auth (Managed Better Auth) — authentification individuelle (PRD
# §16.5, D-19), lib/auth/{server,client}.ts. Les deux premières variables
# sont autogénérées par `neon deploy` (neon.ts : auth: true). La troisième
# signe les cookies de session — ≥32 caractères, générée une fois par
# l'agent (CSPRNG), jamais un secret tiers.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
