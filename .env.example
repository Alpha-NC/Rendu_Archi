# RIF-App — variables d'environnement (Phase 0A/0B).
# Ne jamais commiter de vraies valeurs. Ce fichier ne documente que les noms.

# Supabase (voir rif-framework/Implementations/RIF-App/DECISIONS.md — D-02, D-03)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement — jamais préfixé NEXT_PUBLIC_, jamais exposé au client.
SUPABASE_SERVICE_ROLE_KEY=
# Optionnel — par défaut "rif-app-sources" (lib/rif/depot-supabase.ts).
# À définir seulement si le bucket créé porte un autre nom.
SUPABASE_STORAGE_BUCKET=

# LLM multimodal — Claude Sonnet 5 (D-06, docs/decision-llm-multimodal.md).
ANTHROPIC_API_KEY=

# fal.ai — appel direct depuis le backend applicatif (D-05), endpoint
# fal-ai/nano-banana-pro/edit.
FAL_KEY=
